PORT=3001
DB_PATH=./server/db/autohealth.db
NODE_ENV=development
WEBHOOK_SECRET=change-me-in-production

# Email alerts (Gmail App Password). Leave blank to disable email sending.
# 1. Enable 2FA on the Gmail account, then create an App Password at
#    https://myaccount.google.com/apppasswords
# 2. SMTP_USER is the full Gmail address; SMTP_PASS is the 16-char app password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=

# Real AI incident explanations (Claude). Leave blank to fall back to the
# deterministic template text — the app works fine either way.
ANTHROPIC_API_KEY=

# Slack / Discord alerts. Leave blank to disable either one.
# Slack: create an Incoming Webhook at https://api.slack.com/apps -> your app -> Incoming Webhooks
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
